{
    "name": "telegram_bot_message",
    "method": "POST",
    "url": "https://api.telegram.org/bot{authorization}/sendMessage",
    "class": {
        "authorization": "{{DataType=str, Default=$.Telegram}}"
    },
    "headers": {
        "Content-Type": "application/json"
    },
    "body": {
        "chat_id": "{{DataType=str}}",
        "text": "{{DataType=str}}",
        "parse_mode": "HTML"
    }
}