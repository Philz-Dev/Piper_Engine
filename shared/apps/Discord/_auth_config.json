{
    "name": "Discord_Auth",
    "token_url": "https://discord.com/api/oauth2/token",
    "auth_link": "https://discord.com/api/oauth2/authorize?client_id={CLIENT_ID}&redirect_uri={REDIRECT_URI}&response_type=code&scope={scopes}",
    "method": "POST",
    "auth_config": {
        "CLIENT_ID": "YOUR_DISCORD_CLIENT_ID",
        "CLIENT_SECRET": "YOUR_DISCORD_CLIENT_SECRET",
        "scopes": "identify%20webhook.incoming",
        "REDIRECT_URI": "http://localhost:8080/callback"
    }
}