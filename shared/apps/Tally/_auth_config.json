{
    "name": "Tally_auth",
    "token_url": "https://api.tally.so/oauth/token",
    "auth_link": "https://tally.so/oauth/authorize?client_id={CLIENT_ID}&redirect_uri={REDIRECT_URI}&scope={scopes}&response_type=code",
    "class": {
        "CLIENT_ID": "YOUR_TALLY_CLIENT_ID",
        "CLIENT_SECRET": "YOUR_TALLY_CLIENT_SECRET",
        "scopes": "forms:read forms:write webhooks:write",
        "REDIRECT_URI": "http://localhost:8080/callback"
    }
}