{
    "url": "https://api.typeform.com/forms/{form_id}/webhooks/{webhook_tag}",
    "response_navigator": "form.response",
    "method": "post",
    "class": {
        "form_id": "{{DataType=str}}", 
        "webhook_tag": "{{DataType=str}}",
        "authorization": "{{DataType=str, Default=$.Typeform}}"
    },
    "headers": {
        "Authorization": "Bearer {authorization}",
        "Content-Type": "application/json"
    },
    "body": {
        "url": "{{DataType=str, Default=!.universal_webhook}}",
        "enabled": true,
        "secret": "{webhook_tag}"
    }
}