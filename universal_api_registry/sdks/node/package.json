{
  "name": "@stretis-labs/piper-sdk",
  "version": "0.1.5",
  "description": "Node.js SDK for indie automation platforms: list app/action nodes for your picker UI, render their input forms, and turn filled forms into ready-to-fire API requests. Node-for-node port of piper_sdk.py.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "files": [
    "dist"
  ],
  "keywords": [
    "api",
    "integration",
    "automation",
    "oauth",
    "openapi",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/stretis/uiversal-api-registry.git"
  },
  "homepage": "https://github.com/stretis/uiversal-api-registry#readme",
  "bugs": {
    "url": "https://github.com/stretis/uiversal-api-registry/issues"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./dispatcher": {
      "types": "./dist/dispatcher.d.ts",
      "default": "./dist/dispatcher.js"
    },
    "./credentialStore": {
      "types": "./dist/credentialStore.d.ts",
      "default": "./dist/credentialStore.js"
    },
    "./encryptionManager": {
      "types": "./dist/encryptionManager.d.ts",
      "default": "./dist/encryptionManager.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@stretis-labs/piper-schemas": "^0.1.0",
    "better-sqlite3": "^11.0.0 || ^12.0.0 || ^13.0.0",
    "fernet": "^0.4.0",
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "fernet": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    },
    "@stretis-labs/piper-schemas": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^20.11.0",
    "@types/pg": "^8.23.1",
    "better-sqlite3": "^11.0.0 || ^12.0.0 || ^13.0.0",
    "fernet": "^0.4.0",
    "pg": "^8.23.0",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@stretis-labs/piper-sdk": "^0.1.3",
    "express": "^5.2.1"
  }
}
