  "Hubspot": {
    "source_type": "official_api_index",
    "url": "https://api.hubspot.com/public/api/spec/v1/specs",
    "note": "Confirmed from a real fetch of this endpoint (uploaded 2026, 116 resource groups). This is HubSpot's own machine-readable spec index, not a GitHub repo - a different discovery shape than twilio/paypal's 'list files in a repo directory' (see multi_file there). Response shape: {'results': [{'name', 'group', 'versions': [{'version', 'stage', 'openApi'}]}]}. One resource group per named CRM/Marketing/CMS/etc. object type; each has its own version history with its own spec URL, not one spec per group. Selection rule per group: prefer the version with stage=='LATEST', else stage=='STABLE', else fall back to the first available version - 6 of the 116 groups (e.g. 'Forms', 'Commerce Subscriptions') only have DEVELOPER_PREVIEW versions as of this fetch, so LATEST/STABLE alone would silently drop them. Fetching this index itself needed no auth for the user to retrieve it; individual openApi URLs weren't independently re-verified here beyond that - the downstream fetch step will surface any that don't resolve.",
    "category": "crm",
    "icon_url": "https://cdn.jsdelivr.net/npm/simple-icons@latest/icons/hubspot.svg",
    "color": "#ff7a59",
    "index_api": {
      "index_url": "https://api.hubspot.com/public/api/spec/v1/specs",
      "results_path": "results",
      "name_field": "name",
      "group_field": "group",
      "versions_field": "versions",
      "version_stage_field": "stage",
      "version_spec_url_field": "openApi",
      "version_select_priority": [
        "LATEST",
        "STABLE"
      ],
      "version_select_fallback": "first_available",
      "resource_group_count": 116
    }
  },
